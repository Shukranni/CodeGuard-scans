# Frontend environment — copy to `.env` for local development.
#
# Everything here is bundled into the browser build and is therefore PUBLIC.
# Never put an API key, a secret or a password in this file (they belong in
# `backend/.env` or in the hosting platform's environment variables).

# Django backend URL.
#   local development  → http://127.0.0.1:8000
#   hosted deployment  → https://codeguard-api-xxxx.onrender.com
# A scheme-less hostname also works: https:// is added automatically.
VITE_API_BASE_URL=http://127.0.0.1:8000
