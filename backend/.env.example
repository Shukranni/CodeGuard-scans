# ─────────────────────────────────────────────────────────────────────────────
# Backend environment — copy to `backend/.env` and fill in.
#
# This file is read by the Django server only.  The values are NEVER sent to
# the browser: the frontend talks to the API, the API talks to the AI
# provider.  Do not put these values in the root `.env` (that file is bundled
# into the React app and therefore public).
# ─────────────────────────────────────────────────────────────────────────────

# ── AI provider ──────────────────────────────────────────────────────────────
# Which provider to use: "openai", "anthropic", "openrouter" or "auto" (the
# default — "auto" picks whichever provider below has a key).
# CODEGUARD_AI_PROVIDER=auto

# OpenAI (or any OpenAI-compatible gateway)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# OpenRouter — an OpenAI-compatible gateway that fronts many models.
# Key: https://openrouter.ai/settings/keys
# Models: https://openrouter.ai/models
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=minimax/minimax-m3.1-flash:free
# Optional attribution headers (only used for ranking on OpenRouter's dashboard)
# OPENROUTER_SITE_URL=http://localhost:4028
# OPENROUTER_APP_NAME=CodeGuard
# Optional: "low" / "minimal" / "high" — only for models that support it.
# OPENROUTER_REASONING_EFFORT=low

# Request timeout for the provider, in seconds (default 120).
# CODEGUARD_AI_TIMEOUT=120

# Upper bound for the answer length.  0 (the default) means "use the provider
# default".  Reasoning models count their "thinking" tokens against this
# limit, so it needs headroom for them.
# CODEGUARD_AI_MAX_TOKENS=8192

# ── Django ───────────────────────────────────────────────────────────────────
# DJANGO_SECRET_KEY=change-me
# DJANGO_DEBUG=False

# ── Deployment (hosted instance) ─────────────────────────────────────────────
# These only matter when the backend runs on a free host.  Render's blueprints
# and most PaaS inject them through the process environment, so you do not
# need this file there — it is only for running a "production" build locally.

# Comma-separated hostnames the server answers for.  "*" is permissive and
# gets a first deploy working; replace it with the real API hostname.
# DJANGO_ALLOWED_HOSTS=*

# Comma-separated origins of the deployed React app (CORS).
# DJANGO_CORS_ALLOWED_ORIGINS=https://codeguard-web.onrender.com

# Comma-separated origins allowed to POST with a CSRF token (the admin).
# DJANGO_CSRF_TRUSTED_ORIGINS=https://codeguard-api.onrender.com

# Managed Postgres — REQUIRED on hosts with an ephemeral filesystem, because
# SQLite lives on the local disk and is wiped on every restart.
# Get a free database from https://neon.tech, https://supabase.com or
# https://www.aiven.io.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# S3-compatible object storage for the uploaded archives (same reason as the
# database).  Cloudflare R2 (10 GB free) and Backblaze B2 (10 GB free) work.
# AWS_STORAGE_BUCKET_NAME=codeguard-uploads
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# AWS_S3_REGION=auto

# Serve collected static files from this directory (set automatically by the
# Render blueprint; `python manage.py collectstatic --noinput` writes it).
# STATIC_ROOT=

# Scan worker tuning.
# SCAN_WORKER_POLL_INTERVAL=2
# SCAN_STALE_TIMEOUT=900
# SCAN_WORKER_HEARTBEAT_TIMEOUT=30

# Path to gitleaks when it is not on PATH (the Render build installs it into
# /usr/local/bin automatically).
# CODEGUARD_GITLEAKS_BIN=/usr/local/bin/gitleaks
# CODEGUARD_SEMGREP_BIN=

# ── GitHub repository scanning ───────────────────────────────────────────────
# "Connect a GitHub repository" downloads the repository with `git` when it is
# available on PATH and falls back to the GitHub API tarball otherwise.  The
# timeouts below cap how long a single download may take.
# CODEGUARD_GITHUB_TIMEOUT=120
# CODEGUARD_GITHUB_DOWNLOAD_TIMEOUT=90
